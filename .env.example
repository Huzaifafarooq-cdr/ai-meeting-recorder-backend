# Server
NODE_ENV=development
PORT=5000
# comma separated
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ai_meeting_recorder
# true = embedded mongo (no install needed), false = use MONGODB_URI
USE_IN_MEMORY_DB=true

# Auth
# min 32 chars, generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_MEDIA_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
MEDIA_TOKEN_TTL=30m
# lax, or none (needs https) if frontend is on a different domain
COOKIE_SAMESITE=lax

# Storage
STORAGE_DIR=./storage
MAX_UPLOAD_MB=200

# Speech-to-text
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# multi = English + Hindi (and Hinglish), en = English only, hi = Hindi only
STT_LANGUAGE=multi

# LLM (Gemini by default, any OpenAI-compatible API works)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-lite-latest

# Processing
AI_TIMEOUT_MS=120000
JOB_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
# parallel llm requests per recording
LLM_CONCURRENCY=4
# set false to run the worker separately (npm run worker)
RUN_WORKER=true
# pings <url>/api/health every 10 min so free hosts don't sleep (on Render this is automatic)
KEEP_ALIVE_URL=
